# DeepSeek API Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini API Configuration  
GEMINI_API_KEY=your-gemini-api-key-here

# Perplexity API for OSINT enrichment
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# Flask Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true
FLASK_SECRET_KEY=your-secret-key-here

# Database Configuration (for alert storage and audit compliance)
DATABASE_PATH=alerts.db

# SOC (Security Operations Center) Configuration
SOC_METADATA_ENABLED=true
SOC_ALERT_ID_PREFIX=ALERT
SOC_MAX_INVESTIGATION_DEPTH=5

# OpenSearch Configuration for SOC AI Integration (Connector Pattern)
# Uses console proxy pattern: https://your-opensearch:443/api/console/proxy
OPENSEARCH_HOST=your-opensearch.company.com
OPENSEARCH_PORT=9200
OPENSEARCH_USER=your-username
OPENSEARCH_PASSWORD=your-password
OPENSEARCH_SSL=true
OPENSEARCH_VERIFY_CERTS=false

# Index configuration - Dynamic discovery of all OPENSEARCH_*_INDEX variables
# The system will automatically discover ALL indices you configure
# Format: OPENSEARCH_<NAME>_INDEX=<pattern>
OPENSEARCH_INDEX=waf-*                    # Default index (required)
# OPENSEARCH_AUTH_INDEX=auth-logs-*        # Authentication logs
# OPENSEARCH_FIREWALL_INDEX=fw-*           # Firewall logs
# OPENSEARCH_NETWORK_INDEX=network-*       # Network traffic
# Add as many indices as needed - they're discovered automatically

# OpenSearch Performance Settings
OPENSEARCH_TIMEOUT=30
OPENSEARCH_MAX_QUERY_SIZE=1000
OPENSEARCH_CONSOLE_PROXY=true
OPENSEARCH_SLOW_QUERY_THRESHOLD=5000
OPENSEARCH_MAX_RETRIES=3
OPENSEARCH_RETRY_BACKOFF=2

# Alternative index patterns you might use:
# OPENSEARCH_INDEX=logs-*
# OPENSEARCH_INDEX=apache-*
# OPENSEARCH_INDEX=nginx-*