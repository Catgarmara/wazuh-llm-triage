# wazuh-llm-triage env. Copy to ~/.config/wazuh-llm-triage/.env (outside the repo), chmod 600.
# Values already set in the environment win. Empty values are ignored.

# --- LLM provider: Claude (default) or GLM ---
ANTHROPIC_API_KEY=
# TRIAGE_PROVIDER=glm
# GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/anthropic
TRIAGE_MODEL=                 # default claude-opus-5-5, or glm-4.7 when TRIAGE_PROVIDER=glm
TRIAGE_EFFORT=medium          # Claude only

# --- Slack (app from slack-manifest.yaml, Socket Mode) ---
SLACK_BOT_TOKEN=              # xoxb-...
SLACK_APP_TOKEN=              # xapp-... (App-Level Token, connections:write)
SLACK_REPORT_CHANNEL=         # channel ID for the hourly report, e.g. C0123456789
SLACK_ALLOWED_USERS=          # comma-separated user IDs; EMPTY = anyone in the workspace
TRIAGE_REPORT_MINUTE=5        # hourly report minute (UTC)

# --- Paths (optional) ---
# TRIAGE_PROFILE=~/.config/wazuh-llm-triage/prod.yaml
# TRIAGE_DB=~/.local/state/wazuh-llm-triage/triage.db
